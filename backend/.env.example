# ============================================================
# KaamWala API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/kaamwala

# JWT — generate a strong random key in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# App behaviour
DEBUG=false
